# CEDEXX Backend Environment Variables

# Supabase (PostgreSQL Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Resend (Email Service)
RESEND_API_KEY=your-resend-api-key

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL=jasmelacosta@gmail.com

# Frontend URL (for Stripe redirect)
FRONTEND_URL=https://cedexx.net

# Server Config
PORT=3001
NODE_ENV=development

# Admin Auth
ADMIN_SECRET=cedexx-admin-secret-2026
ADMIN_TOKEN=your-secure-admin-token

# AI APIs
GEMINI_API_KEY=your-gemini-key
KIMI_API_KEY=your-kimi-key
DEEPGRAM_API_KEY=your-deepgram-key

# Vapi.ai (Voice)
VAPI_PRIVATE_KEY=your-vapi-private-key

# Cal.com (Scheduling)
CALCOM_API_KEY=your-calcom-key
