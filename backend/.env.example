# CEDEXX Backend Environment Variables
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Email (Resend) ──────────────────────────────
RESEND_API_KEY=re_xxxxxxxx

# ── Admin Auth ──────────────────────────────────
# Token for accessing /api/admin/* endpoints
ADMIN_TOKEN=cedexx-admin-token-change-me
# Fallback secret (for development only)
ADMIN_SECRET=cedexx-admin-secret-2026

# ── Rate Limits ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ── Frontend Origins ────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://cedexx.net,https://www.cedexx.net,http://localhost:5173
