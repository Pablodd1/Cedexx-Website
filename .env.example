RESEND_API_KEY=your_resend_api_key
KIMI_API_KEY=your_kimi_api_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_OPENAI_API_KEY=your_openai_key  # Optional fallback
VITE_GEMINI_API_KEY=your_gemini_api_key

# Vapi.ai (AI Voice)
# Public key for client-side widget
VITE_VAPI_PUBLIC_KEY=5acddf90-ccad-4b4b-aac8-9adcea8d51bb
# Private key for server-side assistant config — NEVER commit to Git
VAPI_PRIVATE_KEY=your_vapi_private_key

# Cal.com (Scheduling)
VITE_CALCOM_PUBLIC_KEY=your_calcom_public_key
CALCOM_API_KEY=your_calcom_api_key

# Stripe (Payments) — REQUIRED for checkout
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin notifications — Email, Telegram, SMS (all fire in parallel)
# Set at least one channel to receive alerts on new registrations & payments
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=info@cedexx.net           # Email to receive alerts (defaults to info@cedexx.net)
ADMIN_SMS_NUMBER=+1XXXXXXXXXX         # Optional: phone number for SMS alerts (US/Canada)
TEXTBELT_KEY=textbelt                 # Optional: TextBelt key for free SMS (1/day)

# Admin Dashboard Password
DASHBOARD_PASSWORD=cedexx2024

# Azure OpenAI (optional fallback for chat)
AZURE_OPENAI_ENDPOINT=your_azure_endpoint
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Twilio — Toll-Free Number
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18555033371

# Twilio — Backup Local Number (for SMS during toll-free verification)
# Buy a local ($1/mo) or mobile ($15/mo) number from Twilio Console
# Set TOLL_FREE_VERIFIED=true once your toll-free verification is approved
TWILIO_BACKUP_PHONE=+1XXXXXXXXXX
TOLL_FREE_VERIFIED=false

# Deepgram (Voicemail Transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key

# GitHub — for data persistence (calls.json, visits.json)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=Pablodd1
GITHUB_REPO_NAME=Cedexx-Website
