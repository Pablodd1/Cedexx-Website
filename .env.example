# CEDEXX Frontend Environment

# API Backend URL (for Stripe checkout, contact forms, etc.)
VITE_API_URL=https://api.cedexx.net

# Stripe Publishable Key (for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# EmailJS (for contact form fallback)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# AI APIs
VITE_GEMINI_API_KEY=your_gemini_key
VITE_OPENAI_API_KEY=your_openai_key

# Vapi.ai (Voice)
VITE_VAPI_PUBLIC_KEY=your_vapi_key

# Cal.com (Scheduling)
VITE_CALCOM_PUBLIC_KEY=your_calcom_key
