{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "cedexx.net" }], "destination": "https://www.cedexx.net/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/stripe/validate-promo", "destination": "/api/stripe/validate-promo.ts" },
    { "source": "/api/stripe/create-checkout", "destination": "/api/stripe/create-checkout.ts" },
    { "source": "/api/register-member", "destination": "/api/register-member.ts" },
    { "source": "/api/webhook/stripe", "destination": "/api/webhook/stripe.ts" },
    { "source": "/api/dashboard/members", "destination": "/api/dashboard/members.ts" },
    { "source": "/api/dashboard/calls", "destination": "/api/dashboard/calls.ts" },
    { "source": "/api/dashboard/analytics", "destination": "/api/dashboard/analytics.ts" },
    { "source": "/api/track-visit", "destination": "/api/track-visit.ts" },
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/send", "destination": "/api/send.js" },
    { "source": "/api/guide-subscribe", "destination": "/api/guide-subscribe.js" },
    { "source": "/api/book-voice", "destination": "/api/voice-booking.ts" },
    { "source": "/api/delete-request", "destination": "/api/delete-request.ts" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
