{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "cedexx.net" }], "destination": "https://www.cedexx.net/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
